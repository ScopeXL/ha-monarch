MONARCH_EMAIL=your-email@example.com
MONARCH_PASSWORD=your-password
# Optional: TOTP secret from Monarch -> Settings -> Security -> "Set up multi-factor authentication"
# If set, MFA is handled automatically; otherwise the script will prompt on first run.
MONARCH_MFA_SECRET=

# Optional: IANA timezone the scheduled refresh times below are interpreted in
# (e.g. America/New_York). Falls back to the host's local time if unset/invalid.
MONARCH_TZ=
# Optional: comma-separated 24-hour HH:MM times at which the server asks Monarch
# to re-sync all accounts from their institutions. Empty disables scheduling
# (the dashboard's Sync button still works on demand). Example: 06:00,12:00,18:00
MONARCH_REFRESH_TIMES=
# Optional: seconds to wait for a refresh to finish, and how often to poll
# Monarch for completion. Defaults shown.
MONARCH_REFRESH_TIMEOUT=300
MONARCH_REFRESH_DELAY=10
